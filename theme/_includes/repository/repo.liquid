{% assign repository = include.repository.repository %}
{% assign repo_url = repository | split: '/' %}
{% assign owner = repo_url[0] %}
{% assign name = repo_url[1] %}

<div class="repo p-2">
  <a class="repository-card" href="https://github.com/{{ repository }}">
    <div class="repository-card-header">
      <span class="repository-card-title"><i class="fa-brands fa-github" aria-hidden="true"></i> {{ name }}</span>
      <span class="repository-card-arrow" aria-hidden="true">↗</span>
    </div>
    <div class="repository-card-owner">{{ owner }}</div>
    <p>{{ include.repository.description }}</p>
    {% if include.repository.language %}
      <div class="repository-card-meta"><span class="repository-language-dot" aria-hidden="true"></span>{{ include.repository.language }}</div>
    {% endif %}
  </a>
</div>
