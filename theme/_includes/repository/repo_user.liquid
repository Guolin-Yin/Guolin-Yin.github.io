<div class="repo repo-profile p-2">
  <a class="repository-profile-card" href="https://github.com/{{ include.user.username }}">
    <span class="repository-profile-mark" aria-hidden="true">GY</span>
    <span class="repository-profile-copy">
      <span class="repository-profile-name"><i class="fa-brands fa-github" aria-hidden="true"></i> {{ include.user.name }}</span>
      <span class="repository-profile-handle">@{{ include.user.username }}</span>
      <span class="repository-profile-description">{{ include.user.description }}</span>
    </span>
    <span class="repository-card-arrow" aria-hidden="true">↗</span>
  </a>
</div>
